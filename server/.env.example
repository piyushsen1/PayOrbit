# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Auth
# Required — the server throws at startup if this is unset. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Database
# Either set DATABASE_URL, or leave it unset and use the discrete DB_* vars below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# Email (bulk payslip sending) — optional; if unset, POST /api/pay-runs/:id/send-payslips
# returns an EMAIL_NOT_CONFIGURED error instead of attempting to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=payroll@payorbit.example
